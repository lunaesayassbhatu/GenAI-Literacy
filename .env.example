# Copy this file to .env and fill in your values
# Get these from your Supabase project: Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Get this from https://console.anthropic.com — used only by the /api/chat
# serverless function (Ask Wave chatbot). Do NOT prefix this with VITE_:
# that would bundle it into the client and expose it to every visitor.
# Set it in Vercel project settings (Production + Preview + Development).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

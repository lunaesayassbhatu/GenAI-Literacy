# Copy this file to .env and fill in your values
# Get these from your Supabase project: Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# CreateAI (ASU) service token — request it in CreateAI under
# Profile → API Keys. Used only by the /api/chat serverless function
# (Ask Wave chatbot). Do NOT prefix this with VITE_: that would bundle it
# into the client and expose it to every visitor.
# Set it in Vercel project settings (Production + Preview + Development).
CREATEAI_API_KEY=your-createai-service-token-here
